# Replace this value before sharing or deploying the application.
SECRET_KEY=change-this-to-a-long-random-secret

# By default the project uses SQLite so you can run it before configuring MySQL.
# To use XAMPP MySQL on port 3307, uncomment and adjust this URL:
# DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3307/smart_attendance?charset=utf8mb4

# Face recognition settings (used after installing requirements-face.txt)
FACE_MODEL=ArcFace
FACE_DETECTOR_BACKEND=opencv
FACE_MATCH_THRESHOLD=0.35

# Sumber identitas mahasiswa/dosen: sample (data contoh) atau pustik.
IDENTITY_PROVIDER=sample
PUSTIK_BASE_URL=
PUSTIK_API_KEY=
PUSTIK_TIMEOUT=8

# Jumlah maksimal pemeriksaan identitas per menit per alamat IP. 0 mematikan pembatas.
IDENTITY_CHECK_RATE_LIMIT=10

# Base URL yang dienkode ke QR sesi. Untuk HP di jaringan yang sama, gunakan alamat LAN laptop;
# untuk akses kamera browser di HP, gunakan HTTPS. Jangan gunakan 127.0.0.1 untuk URL QR pada HP.
APP_BASE_URL=
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
